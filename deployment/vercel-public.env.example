# Copy values into this Vercel project's Environment Variables, not into Git.
APP_ENV=production
APP_DEBUG=false
APP_KEY=GENERATE_A_NEW_KEY_FOR_THIS_PROJECT
APP_URL=https://YOUR-PUBLIC-PROJECT.vercel.app
PORTAL_DOMAIN_SPLIT=true
PUBLIC_DOMAIN=YOUR-PUBLIC-PROJECT.vercel.app
MANAGEMENT_DOMAIN=YOUR-MANAGEMENT-PROJECT.vercel.app
PORTAL_SURFACE=public
PORTAL_HTTPS_ONLY=true
DB_CONNECTION=mysql
DB_HOST=YOUR_HOSTED_MYSQL_HOST
DB_PORT=3306
DB_DATABASE=YOUR_DATABASE
DB_USERNAME=YOUR_PUBLIC_READ_ONLY_USERNAME
DB_PASSWORD=SET_IN_VERCEL
MYSQL_ATTR_SSL_CA=/etc/ssl/cert.pem
SESSION_DRIVER=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=tls://YOUR_PUBLIC_REDIS_HOST
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=SET_IN_VERCEL
REDIS_DB=0
REDIS_CACHE_DB=0
REDIS_PREFIX=rhu-public:
CACHE_PREFIX=rhu-public-cache:
LOG_CHANNEL=stderr
QUEUE_CONNECTION=sync
