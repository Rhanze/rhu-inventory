# Copy values into this Vercel project's Environment Variables, not into Git.
APP_ENV=production
APP_DEBUG=false
APP_KEY=GENERATE_A_DIFFERENT_KEY_FOR_MANAGEMENT
APP_URL=https://YOUR-MANAGEMENT-PROJECT.vercel.app
PORTAL_DOMAIN_SPLIT=true
PUBLIC_DOMAIN=YOUR-PUBLIC-PROJECT.vercel.app
MANAGEMENT_DOMAIN=YOUR-MANAGEMENT-PROJECT.vercel.app
PORTAL_SURFACE=management
PORTAL_HTTPS_ONLY=true
DB_CONNECTION=mysql
DB_HOST=YOUR_HOSTED_MYSQL_HOST
DB_PORT=3306
DB_DATABASE=YOUR_DATABASE
DB_USERNAME=YOUR_MANAGEMENT_USERNAME
DB_PASSWORD=SET_IN_VERCEL
MYSQL_ATTR_SSL_CA=/etc/ssl/cert.pem
SESSION_DRIVER=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=tls://YOUR_MANAGEMENT_REDIS_HOST
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=SET_IN_VERCEL
REDIS_DB=0
REDIS_CACHE_DB=0
REDIS_PREFIX=rhu-management:
CACHE_PREFIX=rhu-management-cache:
PRESCRIPTION_DISK=s3
AWS_ACCESS_KEY_ID=SET_IN_VERCEL
AWS_SECRET_ACCESS_KEY=SET_IN_VERCEL
AWS_DEFAULT_REGION=YOUR_BUCKET_REGION
AWS_BUCKET=YOUR_PRIVATE_BUCKET
# For S3-compatible providers only; use their documented endpoint and region.
AWS_ENDPOINT=https://YOUR_S3_COMPATIBLE_ENDPOINT
AWS_USE_PATH_STYLE_ENDPOINT=false
CRON_SECRET=GENERATE_AT_LEAST_32_RANDOM_CHARACTERS
LOG_CHANNEL=stderr
QUEUE_CONNECTION=sync
